APP_NAME=Kavi
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://new.kavi.cz

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kavi_new
DB_USERNAME=kavi_user
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.eu.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=postmaster@mg.kavi.cz
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="objednavky@kavi.cz"
MAIL_FROM_NAME="${APP_NAME}"

# Mailgun Configuration
MAILGUN_DOMAIN=mg.kavi.cz
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.eu.mailgun.net

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Stripe Configuration (USE LIVE KEYS FOR PRODUCTION!)
STRIPE_KEY=pk_live_
STRIPE_SECRET=sk_live_
STRIPE_WEBHOOK_SECRET=whsec_

# Packeta Configuration
PACKETA_API_KEY=
PACKETA_API_PASSWORD=

# Fakturoid Configuration (OAuth 2.0)
FAKTUROID_CLIENT_ID=
FAKTUROID_CLIENT_SECRET=
FAKTUROID_SLUG=
FAKTUROID_NUMBER_FORMAT=
FAKTUROID_USER_AGENT="Kavi (info@kavi.cz)"

# Meta (Facebook) Pixel & Conversions API — per region
META_PIXEL_ID_CZ=
META_CONVERSIONS_API_TOKEN_CZ=
META_TEST_EVENT_CODE_CZ=
META_PIXEL_ID_COM=
META_CONVERSIONS_API_TOKEN_COM=
META_TEST_EVENT_CODE_COM=

# Google Analytics 4 — per region
GA_MEASUREMENT_ID_CZ=
GA_MEASUREMENT_ID_COM=

# Žádosti o hodnocení
# Naplánovaný běh reviews:send je vypnutý, dokud tohle není true.
# Nejdřív `php artisan reviews:send --dry-run`, pak teprve zapnout.
REVIEWS_ENABLED=false

# Odkazy na recenzní profily. Stejné hodnoty jsou i jako default
# v config/services.php, aby chybějící proměnná nevyrobila prázdný odkaz.
# Pozor: prázdná hodnota (REVIEW_LINK_GOOGLE=) default NEPŘEBIJE, vyrobí
# prázdný href. Buď vyplň, nebo celý řádek zakomentuj.
# Záloha pro Google, kdyby writereview přestal fungovat:
# https://g.page/r/CUKHHPAV65MnEBM/review
# Každá doména má vlastní Google Business Profile.
REVIEW_LINK_CS=https://search.google.com/local/writereview?placeid=ChIJUTMeyWmRnmERQocc8BXrkyc
REVIEW_LINK_EN=https://search.google.com/local/writereview?placeid=ChIJLztJeicVqCEReL9na5FxkCI

# Čtení vlastních Google recenzí pro sekci na homepage.
# Vyžaduje SCHVÁLENÝ přístup k Google Business Profile API - Google ho
# posuzuje ručně, oficiálně do 14 dnů, reálně 2-6 týdnů. Do schválení není
# API v Cloud Console vůbec vidět a kvóta je 0 QPM.
# Postup: https://developers.google.com/my-business/content/prereqs
#
# refresh_token se získá jednorázovým OAuth souhlasem vlastníka profilu
# (scope business.manage, access_type=offline, prompt=consent).
# OAuth consent screen musí být "In production" - v "Testing" token vyprší za 7 dnů.
#
# Dokud nejsou vyplněné, sekce na HP ukazuje prosbu o hodnocení a cron se přeskakuje.
GOOGLE_REVIEWS_CLIENT_ID=
GOOGLE_REVIEWS_CLIENT_SECRET=

# Sdílený refresh token, když oba profily spravuje jeden Google účet.
# Když má každý vlastní účet, vyplň místo něj _CS_ a _EN_ variantu níž.
GOOGLE_REVIEWS_REFRESH_TOKEN=

# kavi.cz
GOOGLE_REVIEWS_CS_ACCOUNT_ID=
GOOGLE_REVIEWS_CS_LOCATION_ID=
#GOOGLE_REVIEWS_CS_REFRESH_TOKEN=

# kavibox.com
GOOGLE_REVIEWS_EN_ACCOUNT_ID=
GOOGLE_REVIEWS_EN_LOCATION_ID=
#GOOGLE_REVIEWS_EN_REFRESH_TOKEN=

# ID najdeš příkazem: php artisan reviews:refresh-google --discover
